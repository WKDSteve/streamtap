{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may call the app's own commands only; no plugin permissions.",
  "windows": ["main"],
  "permissions": [
    "allow-snapshot",
    "allow-get-settings",
    "allow-save-settings",
    "allow-save-ui-prefs",
    "allow-regenerate-token",
    "allow-start-sink",
    "allow-stop-sink",
    "allow-mux-capture",
    "allow-open-result",
    "allow-open-folder",
    "allow-delete-capture",
    "allow-browser-register",
    "allow-browser-unregister",
    "allow-browser-decide",
    "allow-browser-revoke",
    "allow-browser-tap",
    "allow-phone-pair",
    "allow-phone-devices",
    "allow-phone-revoke"
  ]
}
