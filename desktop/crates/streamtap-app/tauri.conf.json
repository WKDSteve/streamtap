{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "streamtap",
  "version": "0.1.0",
  "identifier": "io.github.wkdsteve.streamtap",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "streamtap",
        "width": 900,
        "height": 600,
        "minWidth": 340,
        "minHeight": 420
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
