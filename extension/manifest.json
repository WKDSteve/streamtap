{
  "manifest_version": 3,
  "name": "streamtap",
  "version": "0.2.0",
  "description": "Taps the segments a video player appends to Media Source Extensions and sends them to the local streamtap sink. Detects DRM and leaves it alone.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "streamtap",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
