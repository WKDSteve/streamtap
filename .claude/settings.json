{
  "env": {
    "DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npx -y modern-web-guidance@latest *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CLAUDE_CODE_REMOTE\" ] || node \"$CLAUDE_PROJECT_DIR/.claude/hooks/cloud-push-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
