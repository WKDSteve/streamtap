# LF in every checkout, whatever core.autocrlf says: rustfmt.toml asks for Unix newlines, so a CRLF
# checkout (a runner without the author's ~/.gitconfig) would fail `cargo fmt --check` on every file.
*.rs text eol=lf
*.toml text eol=lf
Cargo.lock text eol=lf
*.md text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf
